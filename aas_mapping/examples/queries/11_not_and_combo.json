{
  "$condition": {
    "$not": {
      "$and": [
        {
          "$eq": [
            { "$field": "$sme.Status#value" },
            { "$strVal": "Inactive" }
          ]
        },
        {
          "$lt": [
            { "$field": "$sme.Priority#value" },
            { "$numVal": 3 }
          ]
        }
      ]
    }
  }
}

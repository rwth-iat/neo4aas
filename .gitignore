# Python
*.pyc
__pycache__/
*.egg-info/
.venv/
.pytest_cache/

# OS / editor / agent tooling
.DS_Store
.claude/
.idea/

# Agent working documents (kept local, not part of the distribution)
CLAUDE.md
TODOs.md
Report.md
Report2.md

# Large external data: AAS corpora, ECLASS dictionary exports, symlinks into them.
# NOTE: anchored with a leading slash — a bare `eclass` pattern also matched the
# `eclass/` SOURCE packages and silently kept 11 modules out of git.
/data/
/eclass/

# Runtime state written by the demonstrator stack (registry/discovery storage,
# ingested AAS input) — not source.
deploy/demonstrator/input/*
!deploy/demonstrator/input/.gitkeep
deploy/demonstrator/data/registry/storage/
deploy/demonstrator/data/discovery/storage/*.json

# Secrets. `.env.example` is tracked and does not match this pattern.
.env

# Binary presentation assets (diagram SOURCES live in docs/diagrams/*.puml)
docs/presentations/
